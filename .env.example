# 首个注册的账号会成为管理员;也可以在这里预置管理员
ADMIN_USERNAME=
ADMIN_PASSWORD=

# 首个注册的账号会成为管理员;之后是否允许自行注册
ALLOW_REGISTRATION=false

# 上游 API,管理员也可以在页面中修改
API_BASE_URL=https://api.deepseek.com
API_KEY=
API_MODEL=deepseek-flash
# 自定义网关可调整上游路径(默认值适用于 DeepSeek)
API_MESSAGES_PATH=/anthropic/v1/messages
API_FILES_PATH=/anthropic/v1/files
API_MODELS_PATH=/models
API_ASR_PATH=/v1/tools/asr
API_TTS_PATH=/v1/tools/tts

# 通过 HTTPS 反向代理访问时设为 true
COOKIE_SECURE=false
TRUST_PROXY=false